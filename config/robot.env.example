# Copy to robot.env; review before sourcing on both PC and Raspberry Pi.
# These are example values, not measured hardware settings.
export TURTLEBOT3_MODEL=burger
# Choose an available domain with the lab; both machines must match.
export ROS_DOMAIN_ID=30
export ROS_LOCALHOST_ONLY=0
# use_sim_time is a ROS parameter passed to launch, not an environment variable.
# Keep IP addresses, SSH passwords, tokens and Wi-Fi credentials out of Git.
